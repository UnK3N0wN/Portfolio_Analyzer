# Copy this to .env and fill in real values. Never commit the real .env.
#
# NOTE: this one file works for BOTH setups below — just fill in DB_HOST
# correctly for whichever you're actually running:
#
#   Running locally on Windows (no Docker): DB_HOST=localhost — as already
#   set below.
#
#   Running via `docker compose up`: docker-compose.yml overrides DB_HOST
#   to "db" (the container name) automatically, so you don't need to
#   change this file for that case — just make sure
#   DB_NAME/DB_USER/DB_PASSWORD below match what you want docker-compose
#   to create the Postgres container with.

# ── Django core ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ── Database (PostgreSQL) ────────────────────────────────────────────
DB_NAME=portfolio_ai
DB_USER=portfolio_ai
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── Third-party APIs ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ALPHA_VANTAGE_API_KEY=
GROQ_API_KEY=
STOCK_CACHE_TIMEOUT=900
